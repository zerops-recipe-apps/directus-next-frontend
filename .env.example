# ── Directus connection ──────────────────────────────────────────────────────
# URL of your Directus instance. For local development this is localhost:8055.
# On Zerops, set it to your production Directus subdomain URL.
DIRECTUS_URL=http://localhost:8055

# Admin token from your Directus instance.
# Local: generate one in Directus Data Studio → Settings → API tokens.
# Zerops: copy ADMIN_TOKEN from the directus service Secret Variables panel.
DIRECTUS_TOKEN=
